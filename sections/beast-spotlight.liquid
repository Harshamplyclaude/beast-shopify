{%- comment -%}
  Beast spotlight — full-bleed image on one half, a centred statement on the
  other. Modelled on mrbeast.store's feature block: title-case headline, one
  short paragraph, and an underlined text link rather than a filled button.
  Image source order: product featured image > picked image > theme asset.
{%- endcomment -%}
{%- liquid
  assign sp_product = section.settings.product
  assign sp_image = section.settings.image
  if sp_image == blank and sp_product != blank
    assign sp_image = sp_product.featured_image
  endif
-%}
<div class="color-{{ section.settings.color_scheme }} isolate">
  <div class="beast-spotlight{% if section.settings.reverse %} beast-spotlight--reverse{% endif %}">
    <div class="beast-spotlight__media">
      {%- if sp_image != blank -%}
        {{
          sp_image
          | image_url: width: 1800
          | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 50vw, 100vw',
            widths: '600, 900, 1200, 1800',
            alt: sp_image.alt | default: section.settings.heading
        }}
      {%- elsif section.settings.image_asset != blank -%}
        <img
          src="{{ section.settings.image_asset | asset_url }}"
          alt="{{ section.settings.heading | strip_html | escape }}"
          loading="lazy" width="2000" height="1600"
        >
      {%- else -%}
        <div class="beast-slot"><b>Spotlight slot</b><span>portrait or square</span></div>
      {%- endif -%}
    </div>

    <div class="beast-spotlight__body section-{{ section.id }}-padding">
      <div class="beast-spotlight__inner">
        {%- if section.settings.eyebrow != blank -%}
          <p class="beast-spotlight__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="beast-spotlight__heading">{{ section.settings.heading | newline_to_br }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="beast-spotlight__text">{{ section.settings.text }}</div>
        {%- endif -%}
        {%- if section.settings.link_label != blank -%}
          <a class="beast-textlink" href="{{ section.settings.link | default: '#' }}">
            {{- section.settings.link_label | escape -}}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% style %}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.7 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.7 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Beast spotlight",
  "tag": "section",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product",
      "info": "Its featured image is used unless you pick an image below."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "image_asset",
      "label": "Image — theme asset",
      "info": "Filename in assets/. Last fallback."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "The One That Glows"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "Shop the tee"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "checkbox",
      "id": "reverse",
      "label": "Put image on the right",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-3"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 24, "max": 160, "step": 4, "unit": "px",
      "label": "Padding top",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 24, "max": 160, "step": 4, "unit": "px",
      "label": "Padding bottom",
      "default": 96
    }
  ],
  "presets": [
    { "name": "Beast spotlight" }
  ]
}
{% endschema %}
