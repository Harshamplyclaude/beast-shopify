{%- comment -%} Beast category chips — the quick-jump row under the hero. {%- endcomment -%}
<div class="color-{{ section.settings.color_scheme }} isolate">
  <div class="page-width section-{{ section.id }}-padding">
    {%- if section.settings.heading != blank -%}
      <div class="beast-head">
        <h2 class="h1">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.subheading != blank -%}
          <p>{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}
    {%- liquid
      assign has_art = false
      for block in section.blocks
        if block.settings.image != blank or block.settings.image_asset != blank
          assign has_art = true
        endif
      endfor
    -%}

    <div class="beast-chips{% if has_art %} beast-chips--cards{% endif %}">
      {%- for block in section.blocks -%}
        {%- if has_art -%}
          <a href="{{ block.settings.link | default: '#' }}" class="beast-card" {{ block.shopify_attributes }}>
            <div class="beast-card__media">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 900
                  | image_tag:
                    loading: 'lazy',
                    sizes: '(min-width: 750px) 25vw, 50vw',
                    widths: '300, 450, 600, 900',
                    alt: block.settings.label
                }}
              {%- elsif block.settings.image_asset != blank -%}
                <img
                  src="{{ block.settings.image_asset | asset_url }}"
                  alt="{{ block.settings.label | escape }}"
                  loading="lazy" width="1125" height="2000"
                >
              {%- endif -%}
            </div>
            <span class="beast-card__label">
              {{ block.settings.label | escape }}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path d="M9 5l7 7-7 7"/>
              </svg>
            </span>
          </a>
        {%- else -%}
          <a href="{{ block.settings.link | default: '#' }}" class="beast-chip" {{ block.shopify_attributes }}>
            {{- block.settings.label | escape -}}
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% style %}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Beast chips",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Top sellers"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 24
    }
  ],
  "blocks": [
    {
      "type": "chip",
      "name": "Chip",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Tees"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card image",
          "info": "Add an image to any chip and the whole row becomes image cards."
        },
        {
          "type": "text",
          "id": "image_asset",
          "label": "Card image \u2014 theme asset",
          "info": "Filename in assets/. Used when no image is picked above."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Beast chips",
      "blocks": [
        {
          "type": "chip"
        },
        {
          "type": "chip"
        },
        {
          "type": "chip"
        }
      ]
    }
  ]
}
{% endschema %}
