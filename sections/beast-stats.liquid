{%- comment -%} Beast stats — animated counters. Values are plain numbers; the
  script formats and counts up to them once the row scrolls into view. {%- endcomment -%}
<div class="color-{{ section.settings.color_scheme }} isolate">
  <div class="page-width section-{{ section.id }}-padding">
    {%- if section.settings.heading != blank -%}
      <div class="beast-head">
        <h2 class="h1">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.subheading != blank -%}
          <p>{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="beast-stats" data-beast-stats>
      {%- for block in section.blocks -%}
        <div class="beast-stat" {{ block.shopify_attributes }}>
          <div
            class="beast-stat__num"
            data-count-to="{{ block.settings.value }}"
            data-prefix="{{ block.settings.prefix }}"
            data-suffix="{{ block.settings.suffix }}"
          >
            {{- block.settings.prefix }}0{{ block.settings.suffix -}}
          </div>
          <div class="beast-stat__label">{{ block.settings.label | escape }}</div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% style %}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Beast stats",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-3" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px",
      "label": "Top padding", "default": 56 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px",
      "label": "Bottom padding", "default": 56 }
  ],
  "blocks": [
    { "type": "stat", "name": "Stat", "limit": 4, "settings": [
      { "type": "text", "id": "value", "label": "Number", "default": "30",
        "info": "Digits only — the counter animates up to this." },
      { "type": "text", "id": "prefix", "label": "Prefix" },
      { "type": "text", "id": "suffix", "label": "Suffix" },
      { "type": "text", "id": "label", "label": "Label", "default": "Designs" }
    ] }
  ],
  "presets": [ { "name": "Beast stats",
    "blocks": [ { "type": "stat" }, { "type": "stat" }, { "type": "stat" } ] } ]
}
{% endschema %}
