{%- comment -%} Beast tiles — the "shop by category" row. {%- endcomment -%}
<div class="color-{{ section.settings.color_scheme }} isolate">
  <div class="page-width section-{{ section.id }}-padding">
    {%- if section.settings.heading != blank -%}
      <div class="beast-head"><h2 class="h1">{{ section.settings.heading | escape }}</h2></div>
    {%- endif -%}

    <div class="beast-tiles">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.link | default: '#' }}" class="beast-tile" {{ block.shopify_attributes }}>
          <div class="beast-tile__media">
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 1200
                | image_tag:
                  loading: 'lazy',
                  sizes: '(min-width: 750px) 33vw, 100vw',
                  widths: '400, 600, 800, 1200',
                  alt: block.settings.image.alt | default: block.settings.heading
              }}
            {%- elsif block.settings.image_asset != blank -%}
              <img
                src="{{ block.settings.image_asset | asset_url }}"
                alt="{{ block.settings.heading | escape }}"
                loading="lazy" width="1125" height="2000"
              >
            {%- elsif block.settings.collection.featured_image != blank -%}
              {{
                block.settings.collection.featured_image
                | image_url: width: 1200
                | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 33vw, 100vw',
                  widths: '400, 600, 800, 1200',
                  alt: block.settings.collection.title
              }}
            {%- else -%}
              <div class="beast-slot" style="position:absolute">
                <b>Tile slot</b><span>1125 &times; 2000</span>
              </div>
            {%- endif -%}
          </div>
          <div class="beast-tile__body">
            <h3 class="h2">{{ block.settings.heading | default: block.settings.collection.title | escape }}</h3>
            <span class="button button--secondary">
              {{- block.settings.link_label | default: 'View all' | escape -}}
            </span>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

{% style %}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Beast tiles",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by category"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "limit": 6,
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Falls back to the collection image."
        },
        {
          "type": "text",
          "id": "image_asset",
          "label": "Image \u2014 theme asset",
          "info": "Filename in assets/. Used when no image is picked above."
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Button label",
          "default": "View all"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Beast tiles",
      "blocks": [
        {
          "type": "tile"
        },
        {
          "type": "tile"
        },
        {
          "type": "tile"
        }
      ]
    }
  ]
}
{% endschema %}
